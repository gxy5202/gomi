---
import Menu from "@tabler/icons/outline/menu.svg";
import { getRouter } from "@/config";
import { ThemeToggle } from "@/components/starwind/theme-toggle";
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/starwind/sheet";

const routes = Object.values(getRouter()).map((r) => ({
  ...r,
  href: `/${r.path}`.replace(/\/+$/, "") || "/",
}));

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full border-b border-transparent bg-transparent transition-[background-color,backdrop-filter,border-color] duration-300 data-[scrolled]:border-foreground/8 data-[scrolled]:bg-background/60 data-[scrolled]:backdrop-blur-md data-[scrolled]:backdrop-saturate-150"
>
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex items-center gap-2.5" aria-label="Gomi home">
      <img
        src="/Gomi_Avatar.png"
        alt="Gomi"
        width="32"
        height="32"
        class="size-8 rounded-full object-cover"
      />
      <span class="text-chrome text-lg font-bold tracking-tight">Gomi</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        routes.map((route) => (
          <li>
            <a
              href={route.href}
              aria-current={isActive(route.href) ? "page" : undefined}
              class:list={[
                "rounded-lg px-3 py-2 text-sm transition-colors",
                isActive(route.href)
                  ? "bg-muted text-foreground font-medium"
                  : "text-muted-foreground hover:bg-muted/60 hover:text-foreground",
              ]}
            >
              {route.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <ThemeToggle variant="default" size="sm" />
      <div class="md:hidden">
        <Sheet>
          <SheetTrigger
            class="hover:bg-muted hover:text-foreground inline-flex size-9 items-center justify-center rounded-lg transition-colors"
            aria-label="Open navigation menu"
          >
            <Menu class="size-5" />
          </SheetTrigger>
          <SheetContent side="right" class="bg-background/80 backdrop-blur-xl">
            <SheetHeader>
              <SheetTitle class="text-chrome">Gomi</SheetTitle>
            </SheetHeader>
            <ul class="flex flex-col gap-1 px-4">
              {
                routes.map((route) => (
                  <li>
                    <a
                      href={route.href}
                      aria-current={isActive(route.href) ? "page" : undefined}
                      class:list={[
                        "block rounded-lg px-3 py-2.5 text-base transition-colors",
                        isActive(route.href)
                          ? "bg-muted text-foreground font-medium"
                          : "text-muted-foreground hover:bg-muted/60 hover:text-foreground",
                      ]}
                    >
                      {route.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </SheetContent>
        </Sheet>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header && !header.hasAttribute("data-init")) {
    header.setAttribute("data-init", "true");

    const updateScrolled = () => {
      header.toggleAttribute("data-scrolled", window.scrollY > 8);
    };

    window.addEventListener("scroll", updateScrolled, { passive: true });
    document.addEventListener("astro:after-swap", updateScrolled);
    updateScrolled();
  }
</script>
