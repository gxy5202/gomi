---
import Layout from "../layouts/Layout.astro";
import Home from "@tabler/icons/outline/home.svg";
import { Button } from "@/components/starwind/button";
---

<Layout title="404 - Gomi" transition:animate="fade">
  <section class="flex flex-col items-center py-24 text-center">
    <p class="text-chrome text-[8rem] leading-none font-bold tracking-tight sm:text-[12rem]">
      404
    </p>
    <p class="text-muted-foreground mt-6 text-lg">
      This page seems to have dissolved into liquid metal.
    </p>
    <Button href="/" variant="outline" class="glass mt-10 rounded-full">
      <Home class="size-4" />
      Back to Home
    </Button>
  </section>
</Layout>
