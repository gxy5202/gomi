---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/portfolio/ProjectCard.astro";
import { getProjects } from "../config";

// 获取所有项目数据
const projects = getProjects();
---

<Layout title="Portfolio - Gomi" transition:animate="fade">
  <section class="mb-10">
    <h1 class="text-chrome text-4xl font-bold tracking-tight">Portfolio</h1>
  </section>

  <div class="grid gap-5 md:grid-cols-2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Layout>
