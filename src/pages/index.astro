---
import Layout from "../layouts/Layout.astro";
import Home from "../components/home/Home.astro";
import { getCollection } from "astro:content";
import { getProjects, getContributions } from "../config";

// 获取项目数据，只取前4个
const allProjects = getProjects();
const projects = allProjects.slice(0, 4);

// 获取所有博客文章并按发布日期排序，只取最新的3篇
const allBlogPosts = await getCollection("blog");
const recentPosts = allBlogPosts
	.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
	.slice(0, 3);

// 获取贡献数据，提取前5个唯一的项目
const contributions = getContributions();
const uniqueProjects = Array.from(new Set(contributions.map(c => c.project)))
  .slice(0, 5)
  .map(project => {
    const orgName = project.split('/')[0];
    return {
      project,
      iconUrl: `https://github.com/${orgName}.png`,
      orgName,
    };
  });
---

<Layout title="Gomi" transition:animate="fade">
	<Home projects={projects} recentPosts={recentPosts} contributionProjects={uniqueProjects}/>
</Layout>
